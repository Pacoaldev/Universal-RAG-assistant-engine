# ==============================================================================
# Configuración del Asistente RAG Universal
# ==============================================================================

# Modo de LLM: "gemini" o "mock" (para desarrollo/pruebas offline)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Modo de Almacenamiento: "local" (archivo JSON sin GCP) o "firestore" (Google Cloud)
STORAGE_TYPE=local
KNOWLEDGE_BASE_PATH=maskotas_knowledge_base.json

# Configuración de Firestore (Solo requerida si STORAGE_TYPE=firestore)
FIREBASE_CREDENTIALS_PATH=service_account.json

# Configuración del Asistente
ASSISTANT_NAME="Maskotas Bot"
ORGANIZATION_NAME="Clínica Veterinaria Maskotas"

# Configuración de la API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
